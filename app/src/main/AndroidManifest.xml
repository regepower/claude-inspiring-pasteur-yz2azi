<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- A file manager needs all-files access; granted by the user in system settings. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- Lets the app look up which app opens a file type (icon next to the file). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Receives the app picked in the chooser so it is remembered per file type. -->
        <receiver
            android:name=".ChooserReceiver"
            android:exported="false" />
        <provider
            android:name=".FileShare"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true" />
        <!-- Build day (ISO date) from build.gradle.kts. -->
        <meta-data
            android:name="build_date"
            android:value="${buildDate}" />
    </application>
</manifest>
